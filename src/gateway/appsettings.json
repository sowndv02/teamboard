{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "Upstream": {
      "RetryAfterSeconds": 5
    }
  },
  "ReverseProxy": {
    "Routes": {
      "boards-read": {
        "ClusterId": "board-service",
        "Match": {
          "Path": "/api/v1/boards/{**catch-all}",
          "Methods": [ "GET", "HEAD" ]
        }
      },
      "boards-write": {
        "ClusterId": "board-service",
        "Match": {
          "Path": "/api/v1/boards/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        }
      }
    },
    "Clusters": {
      "board-service": {
        "Destinations": {
          "d1": {
            "Address": "http://board-service:7070"
          }
        }
      }
    }
  }
}
