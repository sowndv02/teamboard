{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Gateway": {
    "Upstream": {
      "RetryAfterSeconds": 5
    },
    "BodyLimit": {
      "MaxBytes": 1048576
    }
  },
  "RateLimiting": {
    "Read": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "Write": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownIPNetworks": []
  },
  "ReverseProxy": {
    "Routes": {
      "boards-read": {
        "ClusterId": "board-service",
        "Timeout": "00:00:30",
        "RateLimiterPolicy": "read",
        "Match": {
          "Path": "/api/v1/boards/{**catch-all}",
          "Methods": [ "GET", "HEAD" ]
        }
      },
      "boards-write": {
        "ClusterId": "board-service",
        "Timeout": "00:00:30",
        "RateLimiterPolicy": "write",
        "Match": {
          "Path": "/api/v1/boards/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        }
      }
    },
    "Clusters": {
      "board-service": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://board-service:7070"
          }
        }
      }
    }
  }
}
