@page "/login"
@model IdentityService.Pages.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Sign in</title>
</head>
<body>
    <h1>Sign in</h1>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p role="alert">@Model.ErrorMessage</p>
    }
    <form method="post">
        @if (Model.AuthorizeRequestId is not null)
        {
            <input type="hidden" name="AuthorizeRequestId" value="@Model.AuthorizeRequestId" />
        }
        <div>
            <label for="Email">Email</label>
            <input id="Email" asp-for="Email" autocomplete="username" />
        </div>
        <div>
            <label for="Password">Password</label>
            <input id="Password" asp-for="Password" type="password" autocomplete="current-password" />
        </div>
        <button type="submit">Sign in</button>
    </form>
</body>
</html>